# bob — backend configuration.
#
# Copy to .env.local and fill in to run against the real database.
# Leave both unset and the app runs on the in-memory Skogsstuga sample data.
#
# The database is shared: bob's objects live in the `bob` Postgres schema
# (db/migrations/), and the client in src/data/database.ts is scoped to it.
# API exposure of the schema is handled in SQL by db/migrations/0003 —
# no dashboard configuration needed.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
